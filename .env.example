# Vorlage für die lokale .env bzw. die Umgebungsvariablen auf dem Server.
# Kopieren nach .env und ausfüllen — .env selbst gehört nicht ins Repo.

# --- Grundkonfiguration ---
SECRET_KEY=bitte-einen-langen-zufaelligen-wert-setzen
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Ohne DATABASE_URL wird lokal SQLite benutzt.
# DATABASE_URL=postgres://user:passwort@host:5432/datenbank

# --- E-Mail ---
# Ohne EMAIL_BACKEND landen alle Mails nur in der Konsole. In Produktion muss
# das SMTP-Backend gesetzt sein, sonst kommen Passwort-Reset, E-Mail-Bestätigung
# und der Arbeitszeitnachweis nie beim Empfänger an.
# Prüfen mit: python manage.py sendtestemail deine@adresse.de
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
# Die Absenderdomain braucht beim Mailanbieter SPF- und DKIM-Einträge,
# sonst landen die Mails im Spam.
DEFAULT_FROM_EMAIL=noreply@wochii.de

# --- Externe Dienste ---
OPENAI_API_KEY=
CLOUDINARY_URL=

# --- API / Mobile-App ---
# Kommaseparierte Liste zusätzlicher erlaubter Origins.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
